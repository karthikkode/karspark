#!/usr/bin/env bash
# Make room for one big GPU service by stopping the others, then WAIT until the memory is
# actually back. Runs ON THE SPARK, as a unit's ExecStartPre.
#
# Every GPU service shares the same 121 GiB of unified memory. `Conflicts=` stops the
# other unit, but systemd returns long before the kernel has reclaimed tens of GB, and
# vLLM measures free memory in its first second and refuses:
#
#   ValueError: Free memory on device cuda:0 (86.46/121.69 GiB) on startup is less than
#   desired GPU memory utilization (0.8, 97.35 GiB)
#
# A fixed `sleep` is wrong in both directions. Poll MemAvailable instead.
#
#   gpu-residency <need-GiB> [unit-to-stop ...]
set -u
NEED="${1:?usage: gpu-residency <need-GiB> [unit ...]}"
shift
DEADLINE=$((SECONDS + ${RESIDENCY_WAIT:-240}))

for u in "$@"; do
  if systemctl --user is-active --quiet "$u"; then
    echo "[residency] stopping $u"
    systemctl --user stop "$u"
  fi
done

# Anything started by hand is outside systemd's reach. Report it; do not pattern-kill it,
# because `pkill -f` matches the ssh command line carrying this script.
stray="$(pgrep -af 'vllm|sglang|ComfyUI/main.py|llama-server' 2>/dev/null | grep -v gpu-residency || true)"
[ -n "$stray" ] && echo "[residency] NOTE: GPU processes outside systemd:" && echo "$stray"

avail () { awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo; }

while :; do
  a="$(avail)"
  if [ "$a" -ge "$NEED" ]; then
    echo "[residency] ${a} GiB available, need ${NEED} -- ok"
    exit 0
  fi
  if [ "$SECONDS" -ge "$DEADLINE" ]; then
    echo "[residency] TIMEOUT: only ${a} GiB available, need ${NEED}"
    exit 75   # EX_TEMPFAIL: a transient resource problem, not a bad configuration
  fi
  echo "[residency] ${a}/${NEED} GiB, waiting"
  sleep 5
done
