[Unit]
Description=<service>: <model> on :<port>
After=network-online.target docker.service
Wants=network-online.target
# List every other GPU service here (one big tenant at a time).
Conflicts=
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/services/<service>/env
# Stop the other GPU services and wait until <GiB> is actually free.
ExecStartPre=%h/bin/gpu-residency <GiB>
ExecStart=%h/services/<service>/launch.sh
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
KillMode=mixed

[Install]
WantedBy=default.target
