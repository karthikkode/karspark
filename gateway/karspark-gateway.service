[Unit]
Description=karspark gateway (llama-swap in Docker): the single model endpoint on :8080
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# The gateway runs as a container. --network host lets it reach backends on 127.0.0.1:<port>; the Docker
# socket lets it start/stop backend containers. KARSPARK_* are HOST paths used in recipe volume mounts.
ExecStartPre=-/usr/bin/docker rm -f karspark-gateway
ExecStart=/usr/bin/docker run --rm --name karspark-gateway --network host \
  -v /var/run/docker.sock:/var/run/docker.sock -v %h/gateway:/gateway:ro \
  --env-file %h/gateway/env -e KARSPARK_MODELS=%h/models -e KARSPARK_ENGINES=%h/engines \
  karspark/gateway:265 -config /gateway/config.yaml -listen 0.0.0.0:8080 -watch-config
# docker stop lets llama-swap run every loaded recipe's cmdStop before it exits.
ExecStop=/usr/bin/docker stop -t 110 karspark-gateway
Restart=always
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=default.target
