[Unit]
Description=karspark-core: the single API on :8080 (keys, modes, scheduler, jobs, logging, MCP)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# --network host: core reaches engines on 127.0.0.1:<port> and serves :8080. The Docker socket lets it start
# and stop engine containers; recipe paths are HOST paths (KARSPARK_MODELS/ENGINES/HOST_DATA).
# Engines run detached, so restarting core never unloads a model: it adopts them on start.
ExecStartPre=-/usr/bin/docker rm -f karspark-core
ExecStart=/usr/bin/docker run --rm --name karspark-core --init --network host \
  --gpus all -e NVIDIA_DRIVER_CAPABILITIES=utility \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v %h/core/config:/opt/karspark:ro -v %h/data:/data \
  --env-file %h/core/env \
  -e KARSPARK_MODELS=%h/models -e KARSPARK_ENGINES=%h/engines -e KARSPARK_HOST_DATA=%h/data \
  karspark/core:0.1.0-r16
ExecStop=/usr/bin/docker stop -t 30 karspark-core
Restart=always
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
