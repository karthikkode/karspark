{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen38": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8-27B (DGX Spark)",
      "options": {
        "baseURL": "http://127.0.0.1:30001/v1",
        "apiKey": "{file:/home/karthik/.config/qwen38/api-key}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B NVFP4+DFlash2 (local)",
          "limit": {
            "context": 194048,
            "input": 194048,
            "output": 64000
          },
          "variants": {
            "low": {
              "chat_template_kwargs": {
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "chat_template_kwargs": {
                "reasoning_effort": "xhigh"
              }
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "qwen38/qwen3.8-27b",
  "small_model": "qwen38/qwen3.8-27b"
}
