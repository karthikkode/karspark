[Unit]
Description=Keepalive proxy in front of the serving engine :30000 (agent clients connect to :30001)
After=network-online.target qwen38-sglang.service qwen38-flash.service
Wants=network-online.target

[Service]
Type=simple
User=karthik
Group=karthik
Environment=UPSTREAM=http://127.0.0.1:30000
Environment=KEEPALIVE_S=10
Environment=MAX_SILENCE_S=3600
ExecStart=/usr/bin/python3 /home/karthik/.config/qwen38/keepalive-proxy.py 30001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
