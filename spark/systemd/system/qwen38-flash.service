[Unit]
Description=Qwen3.8-Flash-Next NVFP4 + MTP (vLLM, PLE table on NVMe, capped docker), OpenAI API :30000
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=karthik
Group=karthik
ExecStartPre=-/usr/bin/docker rm -f qwen38-flash
ExecStart=/bin/bash /home/karthik/.config/qwen38/launch-flash.sh
ExecStop=-/usr/bin/docker stop -t 20 qwen38-flash
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
