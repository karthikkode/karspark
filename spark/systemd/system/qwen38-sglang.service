[Unit]
Description=Qwen3.8-27B NVFP4 + DFlash2 (SGLang, capped docker), OpenAI+Anthropic API :30000
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=karthik
Group=karthik
ExecStartPre=-/usr/bin/docker rm -f qwen38-sglang
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-sglang --gpus all \
  --memory 100g --memory-swap 100g --shm-size 16g --network host --ipc=host \
  -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
  -v /home/karthik/.config/qwen38/sglang-cache:/cache \
  -v /home/karthik/.cache/huggingface:/root/.cache/huggingface \
  -v /home/karthik/models:/models \
  -v /home/karthik/.config/qwen38:/out \
  qwen38-dflash2:v1.2.2 \
  python3 -m sglang.launch_server \
    --trust-remote-code --model-path /models/qwen38-27b-nvfp4 --tp-size 1 \
    --served-model-name qwen3.8-27b \
    --mem-fraction-static 0.50 \
    --attention-backend flashinfer --chunked-prefill-size 8192 \
    --disable-prefill-cuda-graph --cuda-graph-max-bs 8 \
    --disable-flashinfer-autotune \
    --speculative-algorithm DFLASH --speculative-draft-model-path /models/qwen38-27b-dflash2 \
    --speculative-num-draft-tokens 8 --speculative-draft-model-quantization unquant \
    --mamba-radix-cache-strategy extra_buffer --mamba-ssm-dtype bfloat16 \
    --max-mamba-cache-size 96 --max-running-requests 6 --schedule-conservativeness 2.0 \
    --enable-torch-compile --torch-compile-max-bs 4 \
    --num-continuous-decode-steps 2 --sleep-on-idle \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
    --chat-template /out/chat-template-sglang.jinja \
    --api-key "$(cat /home/karthik/.config/qwen38/api-key)" \
    --host 0.0.0.0 --port 30000'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-sglang
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
