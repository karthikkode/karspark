[Unit]
Description=Qwen 3.8 27B Abliterated personal-chat server on DGX Spark
After=network-online.target
Wants=network-online.target
Conflicts=qwen38-27b-hybrid.service qwen38-flash.service vllm-122b.service comfyui.service indextts-2.service

[Service]
Type=simple
# Starting this personal-chat model deliberately evicts mutually exclusive GPU workloads.
ExecStartPre=/bin/bash /home/karthik/kathawin-work/bin/gpu_residency.sh 104 qwen38-27b-hybrid.service qwen38-flash.service vllm-122b.service comfyui.service indextts-2.service
Environment=GPU_UTIL=0.80
Environment=MAX_SEQS=1
Environment=MAX_LEN=262144
Environment=SPEC_TOKENS=3
EnvironmentFile=/home/karthik/.config/qwen38-27b-hybrid/env
ExecStart=/home/karthik/.config/qwen38-27b-abliterated/serve.sh
Restart=no
RestartSec=15
TimeoutStartSec=1200
KillMode=mixed

[Install]
WantedBy=default.target
