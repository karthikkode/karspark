[Unit]
Description=ComfyUI (headless, for the Kathawin video pipeline)
After=network-online.target
Wants=network-online.target
Conflicts=vllm-122b.service

[Service]
Type=simple
WorkingDirectory=/home/karthik/ComfyUI
ExecStartPre=/bin/bash /home/karthik/kathawin-work/bin/gpu_residency.sh 60 vllm-122b
ExecStart=/home/karthik/flux2/.venv/bin/python main.py --listen 127.0.0.1 --port 8188 --disable-auto-launch
Restart=on-failure
RestartSec=10
# vLLM wants the same unified memory, so the two must never be resident together.

[Install]
WantedBy=default.target
